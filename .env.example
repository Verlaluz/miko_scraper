# Server configuration
# When running natively:  SERVER_HOST=127.0.0.1
# When running in Docker: SERVER_HOST=0.0.0.0  (set via docker-compose.yml)
SERVER_HOST=127.0.0.1
SERVER_PORT=3000

# SQLite Database connection string
# When running natively:  DATABASE_URL=sqlite:miko_scraper.db
# When running in Docker: DATABASE_URL=sqlite:/app/data/miko_scraper.db  (set via docker-compose.yml)
DATABASE_URL=sqlite:miko_scraper.db

# 32-byte encryption key encoded as 64 hex characters (256 bits)
# Generated for AES-GCM-256 session encryption at rest
# Generate a real key with: openssl rand -hex 32
APP_SECRET_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Logging level
RUST_LOG=info,miko_scraper=debug

# Telegram Bot Token (optional — leave blank to disable Telegram notifications)
TELOXIDE_TOKEN=your_telegram_bot_token_here

# Comma-separated Telegram user IDs allowed to manage workers and view /admin.
ADMIN_TELEGRAM_IDS=123456789
