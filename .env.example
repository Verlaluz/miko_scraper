# Server configuration
SERVER_HOST=127.0.0.1
SERVER_PORT=3000

# SQLite Database connection string
DATABASE_URL=sqlite:miko_scraper.db

# 32-byte encryption key encoded as 64 hex characters (256 bits)
# Generated for AES-GCM-256 session encryption at rest
APP_SECRET_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Logging level
RUST_LOG=info,miko_scraper=debug
